# Copy or generate this file as config/usb_ports.env.
# Prefer stable /dev/serial/by-id and /dev/v4l/by-id paths when available.

export AMR_FRONT_LIDAR_PORT=/dev/serial/by-id/usb-front-lidar
export AMR_REAR_LIDAR_PORT=/dev/serial/by-id/usb-rear-lidar
export AMR_MOTOR_DRIVER_PORT=/dev/serial/by-id/usb-motor-driver
export AMR_DEPTH_CAMERA_DEVICE=/dev/v4l/by-id/usb-depth-camera

export FRONT_LIDAR_PORT="${AMR_FRONT_LIDAR_PORT}"
export REAR_LIDAR_PORT="${AMR_REAR_LIDAR_PORT}"
export MOTOR_DRIVER_PORT="${AMR_MOTOR_DRIVER_PORT}"
export DEPTH_CAMERA_DEVICE="${AMR_DEPTH_CAMERA_DEVICE}"
